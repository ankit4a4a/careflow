NODE_ENV=development
PORT=5010
CLIENT_ORIGIN=http://localhost:5010,http://localhost:5500
MONGODB_URI=mongodb://127.0.0.1:27017/careflow_dev?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Optional SMTP for password reset and verification emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CareFlow <no-reply@example.com>
CLIENT_URL=http://localhost:5010
REQUIRE_EMAIL_VERIFICATION=false
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Phase 6: no payment gateway credentials are configured. Staff-recorded payments only;
# enable a gateway only after adding a provider SDK and verifying signed server callbacks.
# Configure tax profiles in the CareFlow Service Catalogue after professional review.

# Phase 7 legacy stock migration: set both explicitly before running the one-time migration script.
# The script assigns only unassigned legacy batches to this tenant/branch and records opening balances.
PHARMACY_LEGACY_TENANT_ID=
PHARMACY_LEGACY_BRANCH_ID=

# Public browser URL used for employee account invitation links
CLIENT_PUBLIC_URL=http://localhost:5010
# Set true only if you want the API process to run background workers inline
ENABLE_INLINE_WORKERS=false

# Private HRM uploads directory (must not be served by the web server)
HRM_PRIVATE_STORAGE_DIR=./private-uploads/hrm

# Private report exports (outside the public client directory)
REPORT_PRIVATE_STORAGE_DIR=./private-uploads/reports

# Deployment (Render etc.)
# Number of reverse proxies in front of the API (Render = 1). Needed for correct client IPs / rate limiting.
TRUST_PROXY=1
# If the client is on a different domain than the API, set COOKIE_SAMESITE=none AND COOKIE_SECURE=true (HTTPS only).
COOKIE_SAMESITE=strict

# Frontend (../client) is now served by this Node server: open http://localhost:5010

# DEV ONLY: skip login completely and act as DEV_USER_EMAIL (ignored when NODE_ENV=production)
DISABLE_AUTH=false
DEV_USER_EMAIL=admin@careflow.demo

# Admin login created/updated automatically on every server start (no seed needed)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@careflow.com
ADMIN_PASSWORD=Careflow@12345
